{
  "name": "geo-go-go",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "stop": "node scripts/stop-dev-server.mjs",
    "dev": "vite --port 5173 --strictPort",
    "show:view": "node scripts/show-map-view.mjs",
    "read:view": "node scripts/read-map-view.mjs",
    "build": "npm run check:country-names && npm run check:marine-labels && npm run check:counties && npm run check:states && vue-tsc -b && vite build",
    "check:country-names": "node scripts/validate-country-names.mjs",
    "check:marine-labels": "node scripts/validate-marine-labels.mjs",
    "preview": "vite preview",
    "release:merge": "node scripts/release-merge.mjs",
    "check:counties": "node scripts/validate-norway-counties.mjs",
    "check:states": "node scripts/validate-us-states.mjs"
  },
  "dependencies": {
    "@zanmato/vue3-treeselect": "^0.4.4",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "driver.js": "^1.9.0",
    "flag-icons": "^7.5.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
